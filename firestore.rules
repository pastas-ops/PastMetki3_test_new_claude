rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function other(m) {
      return m[0] == request.auth.uid ? m[1] : m[0];
    }

    match /logins/{l} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /profiles/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == u;
    }

    match /users/{u} {
      allow read, write: if request.auth != null && request.auth.uid == u;
    }

    // Приглашение можно отправить только от своего имени и с правильным id.
    match /requests/{r} {
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && r == request.resource.data.from + '_' + request.resource.data.to;
      allow read, delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Общий дедлайн: в чате с другом (cid) или в группе (gid).
    // В группе писать (и создавать дедлайны) может только не заглушённый участник.
    match /shared/{x} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && (
          (!('gid' in request.resource.data)
            && exists(/databases/$(database)/documents/chats/$(request.resource.data.cid))
            && get(/databases/$(database)/documents/chats/$(request.resource.data.cid)).data.members == request.resource.data.members)
          ||
          ('gid' in request.resource.data
            && exists(/databases/$(database)/documents/groups/$(request.resource.data.gid))
            && get(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.members == request.resource.data.members
            && !(request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.get('muted', [])))
        );
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow read, delete: if request.auth != null && request.auth.uid in resource.data.members;
    }

    // Приглашения в группу. Документ ginv/{gid}_{uid}. Создаёт отправитель, читает/удаляет отправитель или получатель.
    match /ginv/{i} {
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && i == request.resource.data.gid + '_' + request.resource.data.to;
      allow read, delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Группы. Создатель (owner) может всё: менять название/фото, мутить участников, удалить группу.
    // Группа создаётся с одним участником (создателем); остальные вступают, приняв приглашение (ginv).
    // Обычный участник может только обновить last (новое сообщение) или выйти из группы.
    match /groups/{g} {
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.owner && request.resource.data.owner == resource.data.owner)
        // вступление по приглашению от создателя: добавляет в members только себя
        || (!(request.auth.uid in resource.data.members)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.hasAll(resource.data.members)
            && request.auth.uid in request.resource.data.members
            && exists(/databases/$(database)/documents/ginv/$(g + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/ginv/$(g + '_' + request.auth.uid)).data.from == resource.data.owner)
        || (request.auth.uid in resource.data.members && request.resource.data.owner == resource.data.owner && (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last'])
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                  && !(request.auth.uid in request.resource.data.members)
                  && request.resource.data.members.size() == resource.data.members.size() - 1
                  && request.resource.data.members.hasOnly(resource.data.members))
        ))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;

      match /msgs/{m} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(g)).data.members;
        allow create: if request.auth != null
          && request.resource.data.f == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(g)).data.members
          && !(request.auth.uid in get(/databases/$(database)/documents/groups/$(g)).data.get('muted', []));
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(g)).data.members
          && (resource.data.f == request.auth.uid
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['k', 'dn']));
        allow delete: if request.auth != null
          && (resource.data.f == request.auth.uid
              || request.auth.uid == get(/databases/$(database)/documents/groups/$(g)).data.owner);
      }
    }

    // Чат (дружба) создаётся только если второй человек прислал приглашение.
    match /chats/{c} {
      allow create: if request.auth != null
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && exists(/databases/$(database)/documents/requests/$(other(request.resource.data.members) + '_' + request.auth.uid));
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow read, delete: if request.auth != null && request.auth.uid in resource.data.members;

      match /msgs/{m} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.members;
      }
    }
  }
}
