<?xml version="1.0" encoding="utf-8"?>
<!-- ВАЖНО: в RemoteViews нельзя использовать простой View и Space (виджет перестаёт загружаться). Только TextView, ImageView, LinearLayout и т.п. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/pm_row_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/bar"
        android:layout_width="4dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:scaleType="fitXY"
        android:src="@drawable/pm_bar" />

    <LinearLayout
        android:id="@+id/ckw"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:gravity="center">

        <TextView
            android:id="@+id/ck"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/pm_ck_off"
            android:gravity="center"
            android:text=""
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="9dp"
        android:paddingTop="9dp">

        <TextView
            android:id="@+id/t"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/s"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="1dp"
            android:textColor="#A6A6B8"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:textColor="#FFC400"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
